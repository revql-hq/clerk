{
  "name": "@revql/clerk",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone accounting companion for OpenRevRec",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac zip"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.revql.clerk",
    "productName": "Clerk",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
